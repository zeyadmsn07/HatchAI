# All settings are optional. With nothing set, the app runs with live web research,
# deterministic agents and no LLM, at USD 0.

# ── Optional local open-weight LLM (any OpenAI-compatible server) ────────────
# Ollama:      http://localhost:11434/v1   (after: ollama pull <model>)
# llama.cpp:   http://localhost:8080/v1    (llama-server -m <model.gguf>)
# vLLM / LM Studio: their /v1 endpoint. Comma-separate several URLs; the first that serves
# HATCHAI_LLM_MODEL is used. No hosted or paid APIs are supported.
HATCHAI_LLM_BASE_URL=http://localhost:11434/v1
# Must be an open-weight model name, e.g. qwen3:8b, qwen3:0.6b, llama3.2:1b, gemma3:1b
HATCHAI_LLM_MODEL=qwen3:8b
HATCHAI_LLM_TIMEOUT=60
HATCHAI_LLM_RETRIES=1

# ── Switches ─────────────────────────────────────────────────────────────────
# 1 = never call an LLM (mode LLM_DISABLED). Replays and the default demo always run disabled.
HATCHAI_NO_LLM=0
# 1 = no network access at all for research (used by tests)
HATCHAI_OFFLINE=0

# ── Storage ──────────────────────────────────────────────────────────────────
DB_PATH=hatchai.db
