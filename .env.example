# All settings are optional. With nothing set, the app runs with live web research
# and rule-based / extractive agents (no LLM), at USD 0.

# ── Open-weight LLM, local (preferred) ───────────────────────────────────────
# Ollama URL(s), comma-separated; the first that has OLLAMA_MODEL pulled is used.
OLLAMA_BASE_URL=http://localhost:11434
# Any open-weight model: qwen3:8b (default), qwen3:4b, llama3.1:8b, gemma3:4b, mistral:7b
OLLAMA_MODEL=qwen3:8b
OLLAMA_TIMEOUT=300

# ── Open-weight LLM, hosted free tier (optional fallback) ────────────────────
# Groq free tier serving Meta Llama 3.3 70B (open weights). Leave empty to disable.
GROQ_API_KEY=your-groq-key-here
GROQ_MODEL=llama-3.3-70b-versatile

# ── Switches ─────────────────────────────────────────────────────────────────
# 1 = never call an LLM (rule-based / extractive mode only)
HATCHAI_NO_LLM=0
# 1 = no network access at all (research returns no sources; used by tests)
HATCHAI_OFFLINE=0

# ── Storage ──────────────────────────────────────────────────────────────────
DB_PATH=hatchai.db
