# ── LLM API keys (all optional — app runs in offline mode without them) ──────
# Google AI Studio free tier (Gemini 1.5 Flash, Gemma 4)
GEMINI_API_KEY=
GOOGLE_API_KEY=

# Groq free tier (Llama 3.3 70B, Qwen 3 32B)
GROQ_API_KEY=

# ── App settings ─────────────────────────────────────────────────────────────
# Path to SQLite database file (default: hatchai.db in working directory)
DB_PATH=hatchai.db
